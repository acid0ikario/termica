<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.termica" path="/org/gnome/shell/extensions/termica/">
    <key name="panel-items" type="as">
      <default>['cpu-temp', 'gpu-temp']</default>
      <summary>Metrics shown in the top bar</summary>
    </key>
    <key name="show-labels" type="b">
      <default>false</default>
      <summary>Show short labels next to each value</summary>
    </key>
    <key name="color-temps" type="b">
      <default>true</default>
      <summary>Color high temperatures</summary>
    </key>
    <key name="interval" type="i">
      <range min="1" max="10"/>
      <default>3</default>
      <summary>Seconds between top bar updates</summary>
    </key>
  </schema>
</schemalist>
